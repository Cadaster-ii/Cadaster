# .env.example — copy to .env and fill in real values
# Never commit .env to version control

# ── Attester signing key (REQUIRED) ──────────────────────────────────────────
# 32-byte Ed25519 private key seed, hex-encoded.
# Generate: openssl rand -hex 32
ATTESTER_PRIVATE_KEY_HEX=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cadaster

# ── Geo-check thresholds ─────────────────────────────────────────────────────
MIN_CONFIDENCE_SCORE=70
MAX_POLYGON_AREA_KM2=10000.0
MIN_POLYGON_AREA_M2=1.0
ATTESTATION_TTL_SECONDS=3600

# ── OSM Nominatim ─────────────────────────────────────────────────────────────
# Default uses the public instance. Self-host for production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Sentinel Hub (ESA WorldCover land-cover checks) ───────────────────────────
# Free tier: https://www.sentinel-hub.com/pricing/
# Leave blank to skip land-cover checks (agent will refuse to attest).
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com

# ── Stellar ───────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
REGISTRY_CONTRACT_ID=
VERIFIER_CONTRACT_ID=
TOKEN_CONTRACT_ID=
